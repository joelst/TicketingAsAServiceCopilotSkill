          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "ticket": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Ticket description in HTML. Use <p> for paragraphs, <br> for line breaks, <strong> for bold, <u> for underline. Example: <p><strong>Summary</strong></p><p>Detail</p>"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "Low",
                  "Medium",
                  "Important",
                  "Urgent"
                ]
              },
              "requestor": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "assignee": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "expectedDate": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Date only, format YYYY-MM-DD (e.g. 2026-04-01). Never use a datetime string when customFields is also present — the API silently discards the ticket with no error. The pattern rejects datetime strings even when the validator treats format as a non-asserting annotation."
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tagCategoryId": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "customFields": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "user": {
            "type": "object",
            "required": [
              "id",
              "name",
              "email"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "add_comment",
      "description": "Add a comment to a ticket",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId",
          "comment",
          "user"
        ],
        "properties": {
          "region": {
            "type": "string",
