{
  "version": "0.1.0",
  "name": "ticketing-api-skill-tools",
  "description": "Tool contracts for Ticketing As A Service conversational operations",
  "tools": [
    {
      "name": "list_tickets",
      "description": "List tickets with optional filtering, sorting, and pagination",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Response verbosity for read output. Use summary by default; use full for full-fidelity payloads."
          },
          "search": {
            "type": "string",
            "description": "Full-text search across all ticket fields."
          },
          "title": {
            "type": "string",
            "description": "Filter by ticket title (substring match)."
          },
          "status": {
            "type": "string",
            "description": "Workflow status label. Built-in values include Open, Reopened, Started, Resolved, and Closed, but instances may define custom workflow labels. Discover the exact allowed values for the target instance with get_instance before relying on a specific label."
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "Important",
              "Urgent"
            ]
          },
          "isResolved": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          },
          "tags": {
            "type": "string",
            "description": "Comma-separated tag filter. Format: '{tagCategoryId}_{tagText}' (e.g. '2283653a-8d36-40eb-9a68-73eb3b331811_my tag'). Use get_tags to discover valid tagCategoryId values."
          },
          "orderBy": {
            "type": "string",
            "description": "Field to sort by. Known values: status, ticketId, title, requestorName, requestorEmail, assigneeName, assigneeEmail, expectedDate, priority, createdDateTime, lastInteraction. The backend may accept additional field names; the value is passed through as-is."
          },
          "order": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ]
          },
          "select": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "createdAfter": {
            "type": "string"
          },
          "createdBefore": {
            "type": "string"
          },
          "expectedDateAfter": {
            "type": "string"
          },
          "expectedDateBefore": {
            "type": "string"
          },
          "lastUpdateAfter": {
            "type": "string"
          },
          "lastUpdateBefore": {
            "type": "string"
          },
          "continuationToken": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_ticket",
      "description": "Get a ticket by id",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Response verbosity. summary returns concise ticket fields; full includes embedded activity details."
          },
          "continuationToken": {
            "type": "string",
            "description": "Activity-page continuation token for embedded activities when mode=full. Does not page the ticket resource."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum number of embedded activity records to fetch when mode=full. Does not limit ticket retrieval."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_ticket_activities",
      "description": "Get ticket activities with continuation token pagination and summary/full output modes",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Response verbosity for activity output. summary returns compact activity records; full returns full-fidelity activity fields."
          },
          "continuationToken": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_ticket",
      "description": "Create a new ticket",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticket",
          "user"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "ticket": {
            "type": "object",
            "required": [
              "title",
              "requestor"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Ticket description in HTML. Use <p> for paragraphs, <br> for line breaks, <strong> for bold, <u> for underline. Example: <p><strong>Summary</strong></p><p>Detail</p>"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "Low",
                  "Medium",
                  "Important",
                  "Urgent"
                ]
              },
              "requestor": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "email"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "assignee": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "expectedDate": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "Date only, format YYYY-MM-DD (e.g. 2026-04-01). Never use a datetime string when customFields is also present — the API silently discards the ticket with no error. The pattern rejects datetime strings even when the validator treats format as a non-asserting annotation."
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tagCategoryId": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "customFields": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "user": {
            "type": "object",
            "required": [
              "id",
              "name",
              "email"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "update_ticket_status",
      "description": "Update ticket status with optional resolution and comment",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId",
          "status",
          "user"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Target workflow status label. Built-in values include Open, Reopened, Started, Resolved, and Closed, but instances may define custom workflow labels. Discover the exact allowed values for the target instance with get_instance before attempting a status change."
          },
          "resolution": {
            "type": "string",
            "description": "Resolution code, required when status is Resolved or Closed. Canonical values: fixed, cannotResolve, cancelled. Common variants (e.g. 'canceled', 'cannot resolve') are normalized by the adapter, and instances with custom workflows may define other codes, so any non-empty string is accepted. Prefer a canonical value when possible."
          },
          "comment": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "required": [
              "id",
              "name",
              "email"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "update_ticket",
      "description": "Update ticket fields such as title, assignee, priority, and custom fields",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId",
          "ticket",
          "user"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
