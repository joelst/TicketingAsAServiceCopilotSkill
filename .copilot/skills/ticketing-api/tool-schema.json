{
  "version": "0.1.0",
  "name": "ticketing-api-skill-tools",
  "description": "Tool contracts for Ticketing As A Service conversational operations",
  "tools": [
    {
      "name": "list_tickets",
      "description": "List tickets with optional filtering, sorting, and pagination",
      "inputSchema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Response verbosity for read output. Use summary by default; use full for full-fidelity payloads."
          },
          "search": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Workflow status label. Built-in values include Open, Reopened, Started, Resolved, and Closed, but instances may define custom workflow labels. Discover the exact allowed values for the target instance with get_instance before relying on a specific label."
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "Important",
              "Urgent"
            ]
          },
          "isResolved": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          },
          "tags": {
            "type": "string"
          },
          "orderBy": {
            "type": "string"
          },
          "order": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ]
          },
          "select": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "createdAfter": {
            "type": "string"
          },
          "createdBefore": {
            "type": "string"
          },
          "expectedDateAfter": {
            "type": "string"
          },
          "expectedDateBefore": {
            "type": "string"
          },
          "lastUpdateAfter": {
            "type": "string"
          },
          "lastUpdateBefore": {
            "type": "string"
          },
          "continuationToken": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_ticket",
      "description": "Get a ticket by id",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Response verbosity. summary returns concise ticket fields; full includes embedded activity details."
          },
          "continuationToken": {
            "type": "string",
            "description": "Activity-page continuation token for embedded activities when mode=full. Does not page the ticket resource."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum number of embedded activity records to fetch when mode=full. Does not limit ticket retrieval."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_ticket_activities",
      "description": "Get ticket activities with continuation token pagination and summary/full output modes",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Response verbosity for activity output. summary returns compact activity records; full returns full-fidelity activity fields."
          },
          "continuationToken": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "create_ticket",
      "description": "Create a new ticket",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticket",
          "user"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "ticket": {
            "type": "object",
            "required": [
              "title",
              "requestor"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "Low",
                  "Medium",
                  "Important",
                  "Urgent"
                ]
              },
              "requestor": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "email"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "assignee": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "expectedDate": {
                "type": "string"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tagCategoryId": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "customFields": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "additionalProperties": false
          },
          "user": {
            "type": "object",
            "required": [
              "id",
              "name",
              "email"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
