    },
    {
      "name": "get_instance",
      "description": "Get instance metadata including workflow and custom field details",
      "inputSchema": {
        "type": "object",
        "required": [
          "region"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "validation_write_closed_ticket_comment",
      "description": "Find a ticket by assignee and requestor, prefer Closed status, write a formatted validation comment, and verify persistence",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "assigneeEmail",
          "requestorEmail"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "assigneeEmail": {
            "type": "string"
          },
          "requestorEmail": {
            "type": "string"
          },
          "allowResolvedFallback": {
            "type": "boolean",
            "default": true
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200
          },
          "maxPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          },
          "stopOnFirstMatch": {
            "type": "boolean",
            "default": true
          },
          "comment": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "find_my_unresolved_tickets",
      "description": "List my unresolved tickets using status as primary signal with resolved compatibility hints",
      "inputSchema": {
        "type": "object",
        "required": [
          "region"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "description": "Email of the user whose tickets to return. Required at call time unless the connection is configured with a default current-user email; the dispatcher throws if neither is available. If it is not supplied and no default is configured, ask the user for their email before calling."
          },
          "assigneeEmail": {
            "type": "string",
            "description": "Legacy alias for userEmail (assignee perspective). Prefer userEmail."
          },
          "perspective": {
            "type": "string",
            "enum": [
              "assignee",
              "requestor",
              "any"
            ],
            "default": "assignee"
          },
          "top": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 25
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200
          },
          "maxPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          },
          "orderBy": {
            "type": "string"
          },
          "order": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "find_my_tickets_with_unread_updates",
      "description": "List my tickets that have unread updates based on unseen event counters",
      "inputSchema": {
        "type": "object",
        "required": [
          "region"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "description": "Email of the user whose tickets to return. Required at call time unless the connection is configured with a default current-user email; the dispatcher throws if neither is available. If it is not supplied and no default is configured, ask the user for their email before calling."
          },
          "assigneeEmail": {
            "type": "string",
            "description": "Legacy alias for userEmail (assignee perspective). Prefer userEmail."
          },
          "perspective": {
            "type": "string",
            "enum": [
              "assignee",
              "requestor",
              "any"
            ],
            "default": "assignee"
          },
          "top": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 25
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200
          },
          "maxPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 8
          },
          "orderBy": {
            "type": "string"
          },
          "order": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_tags",
      "description": "Get all tag categories and their tags. Call this before filtering tickets by tags or creating tickets with tags, to obtain valid tagCategoryId values for the filter format '{tagCategoryId}_{tagText}'.",
      "inputSchema": {
        "type": "object",
        "required": [
          "region"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_ticket_attachments",
      "description": "List all attachments for a ticket.",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "get_activity_attachments",
      "description": "List attachments for a specific activity. The activityId must come from item.activityId in the add_ticket_attachment_links response — not from get_ticket_activities. Passing an activityId from get_ticket_activities returns a 500 error.",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "activityId"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "activityId": {
            "type": "string",
            "description": "Must come from item.activityId in the add_ticket_attachment_links response, not from get_ticket_activities."
          },
          "timezone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "add_ticket_attachment_links",
      "description": "Add attachment links to a ticket activity.",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "ticketId",
          "attachments",
          "user"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
          "ticketId": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "src"
              ],
              "properties": {
                "src": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "description": "HTTPS URL of the attachment. Only https:// URLs are accepted; schemes such as javascript:, file:, and data: are rejected to avoid persisting unsafe links."
                },
                "caption": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "isPrivate": {
            "type": "boolean",
            "default": false
          },
          "user": {
            "type": "object",
            "required": [
              "id",
              "name",
              "email"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  ]
}