    {
      "name": "validation_write_closed_ticket_comment",
      "description": "Find a ticket by assignee and requestor, prefer Closed status, write a formatted validation comment, and verify persistence",
      "inputSchema": {
        "type": "object",
        "required": [
          "region",
          "assigneeEmail",
          "requestorEmail"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu",
              "apac"
            ]
          },
